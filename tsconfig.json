{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2017"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.bak*.ts",
    "**/*.bak*.tsx",
    "**/*.bak*.js",
    "**/*.bak*.jsx",
    "**/*.before_*.ts",
    "**/*.before_*.tsx",
    "**/*.before_*.js",
    "**/*.before_*.jsx",
    "App.before_*.ts",
    "App.before_*.tsx"
  ]
}
