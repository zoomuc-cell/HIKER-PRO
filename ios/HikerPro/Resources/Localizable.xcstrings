    },
    "Location is used in the background only while a hike is being recorded. iOS shows a blue indicator whenever this happens.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치는 산행을 기록하는 동안에만 백그라운드에서 사용됩니다. 이때 iOS 상태 막대에 파란색 표시가 나타납니다."
          }
        }
      }
    },
    "Lowest Point": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최저 지점"
          }
