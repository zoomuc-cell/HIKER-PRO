    "HIKER PRO": {
      "shouldTranslate": false
    },
    "HIKER PRO uses your location to show where you are and to record your route. Your location never leaves this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HIKER PRO는 현재 위치를 표시하고 경로를 기록하기 위해 위치 정보를 사용합니다. 위치 정보는 이 기기 밖으로 전송되지 않습니다."
          }
        }
      }
    },
    "HIKER PRO: I need help. My current location:": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HIKER PRO: 도움이 필요합니다. 현재 제 위치:"
          }
        }
      }
    },
    "Highest Point": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최고 지점"
          }
        }
      }
    },
