    "Track Not Saved": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 저장되지 않음"
          }
        }
      }
    },
    "Tracks": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 목록"
          }
        }
      }
    },
    "Turn On Precise Location": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 위치 켜기"
          }
        }
      }
    },
    "Turn on location access for HIKER PRO in Settings to see your position and record hikes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 확인하고 산행을 기록하려면 설정에서 HIKER PRO의 위치 접근을 켜세요."
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없음"
          }
        }
      }
    },
    "Updated": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전"
          }
        }
      }
    },
    "Waiting for a GPS fix. Move to an open area if you can.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS 신호를 기다리는 중입니다. 가능하면 트인 곳으로 이동하세요."
          }
        }
      }
    },
    "You can also use Emergency SOS: press and hold the side button and either volume button.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴급 구조 요청(SOS)도 사용할 수 있습니다: 측면 버튼과 음량 버튼 중 하나를 길게 누르세요."
          }
        }
      }
    },
    "Your location is shared only with the people or apps you choose. HIKER PRO never sends it automatically.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치는 사용자가 선택한 사람이나 앱에만 공유됩니다. HIKER PRO는 위치를 자동으로 전송하지 않습니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}